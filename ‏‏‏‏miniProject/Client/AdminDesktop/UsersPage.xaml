<Page x:Class="AdminDesktop.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Users Management"
      Background="#0B1017"
      FontFamily="Segoe UI">

    <Page.Resources>

        <!-- BACKGROUND -->
        <LinearGradientBrush x:Key="MainBackground"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#17212C" Offset="0"/>
            <GradientStop Color="#090D12" Offset="1"/>
        </LinearGradientBrush>

        <!-- LABEL STYLE -->
        <Style x:Key="FieldLabel"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D5DEE8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- TEXTBOX STYLE -->
        <Style x:Key="LuxuryTextBox"
               TargetType="TextBox">

            <Setter Property="Background" Value="#0E151E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#C9A96F"/>
            <Setter Property="BorderBrush" Value="#394656"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,18"/>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused"
                         Value="True">
                    <Setter Property="BorderBrush"
                            Value="#C9A96F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- COMBOBOX STYLE -->
        <Style x:Key="LuxuryComboBox"
               TargetType="ComboBox">
            <Setter Property="Background" Value="#F2F3F5"/>
            <Setter Property="Foreground" Value="#141B24"/>
            <Setter Property="BorderBrush" Value="#C9A96F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <!-- GOLD BUTTON -->
        <Style x:Key="GoldButton"
               TargetType="Button">

            <Setter Property="Background" Value="#C9A96F"/>
            <Setter Property="Foreground" Value="#101820"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="210"/>
            <Setter Property="Padding" Value="25,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E8CA94"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#A98A54"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LISTVIEW STYLE -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#121B25"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- TABLE HEADER -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#263543"/>
            <Setter Property="Foreground" Value="#E5C58D"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderBrush" Value="#415061"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- TABLE ROW + RIGHT CLICK -->
        <Style TargetType="ListViewItem">

            <Setter Property="Background" Value="#18232F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <!-- SELECT USER ON RIGHT CLICK -->
            <EventSetter
                Event="PreviewMouseRightButtonDown"
                Handler="UserRow_RightClick"/>

            <!-- RIGHT CLICK MENU -->
            

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#344456"/>
                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="#44576B"/>
                </Trigger>
            </Style.Triggers>

        </Style>

    </Page.Resources>

    <Grid Background="{StaticResource MainBackground}">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto">

            <StackPanel Margin="35,30"
                        MinWidth="760">

                <!-- PAGE HEADER -->
                <Grid Margin="0,0,0,28">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock
                            Text="MERCEDES-BENZ / ADMINISTRATION"
                            Foreground="#C9A96F"
                            FontSize="12"
                            FontWeight="Bold"/>

                        <TextBlock
                            Text="User Management"
                            Foreground="White"
                            FontSize="34"
                            FontWeight="Bold"
                            Margin="0,12,0,8"/>

                        <TextBlock
                            Text="Create and manage Mercedes-Benz user accounts."
                            Foreground="#AEBBC8"
                            FontSize="14"/>

                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#1D2A37"
                            BorderBrush="#394858"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20,12"
                            VerticalAlignment="Center">

                        <StackPanel>
                            <TextBlock
                                Text="MERCEDES-BENZ"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"/>

                            <TextBlock
                                Text="USER CONTROL CENTER"
                                Foreground="#C9A96F"
                                FontSize="10"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"/>
                        </StackPanel>

                    </Border>

                </Grid>

                <!-- INSERT USER SECTION -->
                <Border Background="#151F2A"
                        BorderBrush="#354453"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="28"
                        Margin="0,0,0,24">

                    <StackPanel>

                        <TextBlock
                            Text="CREATE NEW ACCOUNT"
                            Foreground="#C9A96F"
                            FontSize="12"
                            FontWeight="Bold"/>

                        <TextBlock
                            Text="Insert New User"
                            Foreground="White"
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="0,10,0,8"/>

                        <TextBlock
                            Text="Enter the information below to register a new user."
                            Foreground="#AEBBC8"
                            FontSize="13"
                            Margin="0,0,0,26"/>

                        <!-- TWO COLUMNS -->
                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN -->
                            <StackPanel Grid.Column="0">

                                <!-- FIRST NAME -->
                                <TextBlock
                                    Text="FIRST NAME"
                                    Style="{StaticResource FieldLabel}"/>

                                <TextBox
                                    x:Name="textBoxFName"
                                    Style="{StaticResource LuxuryTextBox}"/>

                                <!-- USERNAME -->
                                <TextBlock
                                    Text="USERNAME"
                                    Style="{StaticResource FieldLabel}"/>

                                <TextBox
                                    x:Name="textBoxUserName"
                                    Style="{StaticResource LuxuryTextBox}"/>

                                <!-- EMAIL -->
                                <TextBlock
                                    Text="EMAIL ADDRESS"
                                    Style="{StaticResource FieldLabel}"/>

                                <TextBox
                                    x:Name="textBoxEmailAddress"
                                    Style="{StaticResource LuxuryTextBox}"/>

                            </StackPanel>

                            <!-- RIGHT COLUMN -->
                            <StackPanel Grid.Column="2">

                                <!-- LAST NAME -->
                                <TextBlock
                                    Text="LAST NAME"
                                    Style="{StaticResource FieldLabel}"/>

                                <TextBox
                                    x:Name="textBoxLName"
                                    Style="{StaticResource LuxuryTextBox}"/>

                                <!-- PASSWORD -->
                                <TextBlock
                                    Text="PASSWORD"
                                    Style="{StaticResource FieldLabel}"/>

                                <TextBox
                                    x:Name="textBoxPassword"
                                    Style="{StaticResource LuxuryTextBox}"/>

                                <!-- USER TYPE -->
                                <TextBlock
                                    Text="USER TYPE"
                                    Style="{StaticResource FieldLabel}"/>

                                <ComboBox
                                    x:Name="comboBoxUserType"
                                    Style="{StaticResource LuxuryComboBox}"
                                    SelectedIndex="0">

                                    <ComboBoxItem Content="Admin"/>
                                    <ComboBoxItem Content="Client"/>

                                </ComboBox>

                            </StackPanel>

                        </Grid>

                        <!-- INSERT BUTTON -->
                        <Button
                            Click="BtnApply_Click"
                            x:Name="insertUserButton"
                            Content="INSERT NEW USER"
                            Style="{StaticResource GoldButton}"
                            HorizontalAlignment="Center"
                            Margin="0,15,0,0"/>

                    </StackPanel>
                </Border>

                <!-- USERS TABLE -->
                <Border Background="#151F2A"
                        BorderBrush="#354453"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="25">

                    <StackPanel>

                        <TextBlock
                            Text="AVAILABLE USERS"
                            Foreground="#C9A96F"
                            FontSize="12"
                            FontWeight="Bold"/>

                        <TextBlock
                            Text="Registered Users"
                            Foreground="White"
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="0,10,0,8"/>

                        <TextBlock
                            Text="View all user accounts registered in the system."
                            Foreground="#AEBBC8"
                            FontSize="13"
                            Margin="0,0,0,20"/>

                        <!-- LIST VIEW -->
                        <ListView
    x:Name="listViewUsers"
    Height="340"
    Background="#121B25"
    Foreground="White"
    BorderThickness="0"
    ScrollViewer.HorizontalScrollBarVisibility="Auto">

                            <!-- RIGHT CLICK MENU -->
                            <ListView.ContextMenu>

                                <ContextMenu
            Background="#263543"
            Foreground="White"
            BorderBrush="#415061"
            BorderThickness="1">

                                    <!-- EDIT USER -->
                                    <MenuItem
                Header="Edit User"
                Click="EditUserMenu_Click"
                Foreground="White"/>

                                    <Separator/>

                                    <!-- DELETE USER -->
                                    <MenuItem
                Header="Delete User"
                Click="DeleteUserMenu_Click"
                Foreground="#FF9D9D"/>

                                </ContextMenu>

                            </ListView.ContextMenu>


                            <ListView.View>
                                <GridView>

                                    <GridViewColumn
            Header="ID"
            Width="65"
            DisplayMemberBinding="{Binding Id}"/>

                                    <GridViewColumn
            Header="FIRST NAME"
            Width="125"
            DisplayMemberBinding="{Binding Fname}"/>

                                    <GridViewColumn
            Header="LAST NAME"
            Width="125"
            DisplayMemberBinding="{Binding Lname}"/>

                                    <GridViewColumn
            Header="USERNAME"
            Width="135"
            DisplayMemberBinding="{Binding UserName}"/>

                                    <GridViewColumn
            Header="EMAIL ADDRESS"
            Width="190"
            DisplayMemberBinding="{Binding EmailAddress}"/>

                                    <GridViewColumn
            Header="USER TYPE"
            Width="125"
            DisplayMemberBinding="{Binding UserType}"/>

                                </GridView>
                            </ListView.View>

                        </ListView>

                    </StackPanel>
                </Border>

                <!-- FOOTER -->
                <StackPanel Margin="0,30,0,10"
                            HorizontalAlignment="Center">

                    <Rectangle
                        Width="70"
                        Height="2"
                        Fill="#C9A96F"
                        Margin="0,0,0,14"/>

                    <TextBlock
                        Text="MERCEDES-BENZ"
                        Foreground="#C9A96F"
                        FontSize="13"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="LUXURY  •  INNOVATION  •  PERFORMANCE"
                        Foreground="#788797"
                        FontSize="11"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>
    </Grid>
</Page>


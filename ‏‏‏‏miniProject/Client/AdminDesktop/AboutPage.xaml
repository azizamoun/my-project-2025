<Page x:Class="AdminDesktop.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="About Store"
      Background="#0B0F14"
      FontFamily="Segoe UI">

    <Page.Resources>
        <LinearGradientBrush x:Key="HeroBackground"
                             StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#263340" Offset="0"/>
            <GradientStop Color="#101720" Offset="0.6"/>
            <GradientStop Color="#080B10" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="FeatureCard" TargetType="Border">
            <Setter Property="Background" Value="#171D25"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="BorderBrush" Value="#2C3540"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Background" Value="#C7A66A"/>
            <Setter Property="Foreground" Value="#10151B"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="25,13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E0C18A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel MaxWidth="1100"
                    Margin="40,35,40,55">

            <!-- Page Heading -->
            <TextBlock Text="ABOUT THE STORE"
                       Foreground="#C7A66A"
                       FontSize="13"
                       FontWeight="Bold"
                       />

            <TextBlock Text="Welcome to Mercedes-Benz"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="Bold"
                       Margin="0,10,0,25"/>

            <!-- Main Hero Section -->
            <Border Background="{StaticResource HeroBackground}"
                    CornerRadius="24"
                    Padding="38"
                    BorderBrush="#33404D"
                    BorderThickness="1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="EXCELLENCE IN EVERY DETAIL"
                                   Foreground="#C7A66A"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Luxury Meets&#10;Performance."
                                   Foreground="White"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   Margin="0,15,0,18"/>

                        <TextBlock
                            Text="Discover the world of Mercedes-Benz, where timeless elegance, advanced technology, and exceptional performance come together."
                            Foreground="#B8C1CD"
                            FontSize="15"
                            TextWrapping="Wrap"
                            MaxWidth="520"
                            LineHeight="25"/>

                        <TextBlock Text="Driven by passion. Defined by quality."
                                   Foreground="#C7A66A"
                                   FontSize="14"
                                   FontStyle="Italic"
                                   Margin="0,22,0,0"/>
                    </StackPanel>

                    <!-- Decorative Mercedes-inspired Symbol -->
                    <Grid Grid.Column="1"
                          Width="190" Height="190"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center">

                        <Ellipse Stroke="#354454"
                                 StrokeThickness="1"
                                 Margin="0"/>

                        <Ellipse Stroke="#748393"
                                 StrokeThickness="2"
                                 Margin="17"/>

                        <TextBlock Text="✦"
                                   Foreground="#D6DEE7"
                                   FontSize="120"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Our Story -->
            <TextBlock Text="Our Story"
                       Foreground="White"
                       FontSize="25"
                       FontWeight="Bold"
                       Margin="0,37,0,12"/>

            <TextBlock
                Text="At our Mercedes-Benz showroom, we believe that choosing a vehicle is more than making a purchase. It is the beginning of an extraordinary driving experience. Our mission is to bring you a carefully selected collection of luxury vehicles while providing a professional, transparent, and personalized customer experience."
                Foreground="#B8C1CD"
                FontSize="15"
                TextWrapping="Wrap"
                LineHeight="26"/>

            <!-- Features -->
            <TextBlock Text="Why Choose Us?"
                       Foreground="White"
                       FontSize="25"
                       FontWeight="Bold"
                       Margin="0,37,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource FeatureCard}"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="✦"
                                   Foreground="#C7A66A"
                                   FontSize="32"/>

                        <TextBlock Text="Premium Selection"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,13,0,10"/>

                        <TextBlock
                            Text="Explore a collection of elegant and high-performance Mercedes-Benz vehicles."
                            Foreground="#AAB5C2"
                            FontSize="13"
                            TextWrapping="Wrap"
                            LineHeight="21"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource FeatureCard}"
                        Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="✓"
                                   Foreground="#C7A66A"
                                   FontSize="32"/>

                        <TextBlock Text="Quality First"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,13,0,10"/>

                        <TextBlock
                            Text="We focus on vehicle quality, attention to detail, and a reliable buying experience."
                            Foreground="#AAB5C2"
                            FontSize="13"
                            TextWrapping="Wrap"
                            LineHeight="21"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource FeatureCard}"
                        Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="♡"
                                   Foreground="#C7A66A"
                                   FontSize="32"/>

                        <TextBlock Text="Customer Care"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,13,0,10"/>

                        <TextBlock
                            Text="Our goal is to help every customer find the Mercedes-Benz that matches their lifestyle."
                            Foreground="#AAB5C2"
                            FontSize="13"
                            TextWrapping="Wrap"
                            LineHeight="21"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Contact Section -->

            <!-- Footer -->
            <TextBlock
                Text="MERCEDES-BENZ  •  LUXURY  •  INNOVATION  •  PERFORMANCE"
                Foreground="#7D8998"
                FontSize="11"
                HorizontalAlignment="Center"
                Margin="0,32,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>

<Page x:Class="AdminDesktop.ProductPage"
      xmlns:converters="clr-namespace:AdminDesktop.App_Code.Converters"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AdminDesktop"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">
    <Page.Resources>

        <!-- Keep original converter -->
        <converters:Base64ImageConverter
        x:Key="Base64ImageConverter"/>

        <!-- ADD PRODUCT BUTTON -->
        <Style x:Key="AddProductButtonStyle"
           TargetType="Button">

            <Setter Property="Background" Value="#D5DCE4"/>
            <Setter Property="Foreground" Value="#101720"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9"
                            BorderBrush="#E8EDF2"
                            BorderThickness="1">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">
                                <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">
                                <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#9CA9B6"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DELETE BUTTON -->
        <Style x:Key="DeleteProductButtonStyle"
           TargetType="Button">

            <Setter Property="Background" Value="#47242B"/>
            <Setter Property="Foreground" Value="#FFBFC6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DeleteBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7">
                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                 Value="True">
                                <Setter TargetName="DeleteBorder"
                                    Property="Background"
                                    Value="#8C3541"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DATA GRID -->
        <Style x:Key="ProductsGridStyle"
           TargetType="DataGrid">

            <Setter Property="Background" Value="#101822"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="#141E29"/>
            <Setter Property="AlternatingRowBackground"
                Value="#1C2936"/>
            <Setter Property="ColumnHeaderHeight" Value="43"/>
            <Setter Property="RowHeight" Value="68"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
        </Style>

        <!-- COLUMN HEADERS -->
        <Style x:Key="ProductHeaderStyle"
           TargetType="DataGridColumnHeader">

            <Setter Property="Background" Value="#293847"/>
            <Setter Property="Foreground" Value="#F0F3F7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#3C4B59"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="HorizontalContentAlignment"
                Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                Value="Center"/>
        </Style>

        <!-- ROW STYLE: KEEP DOUBLE CLICK EVENT -->
        <Style x:Key="ProductRowStyle"
           TargetType="DataGridRow">

            <EventSetter Event="MouseDoubleClick"
                     Handler="DataGridRow_MouseDoubleClick"/>

            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                        Value="#304255"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"
                        Value="#35546D"/>
                    <Setter Property="Foreground"
                        Value="White"/>
                </Trigger>

            </Style.Triggers>
        </Style>

        <!-- CELL STYLE -->
        <Style x:Key="ProductCellStyle"
           TargetType="DataGridCell">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background"
                        Value="Transparent"/>
                </Trigger>
            </Style.Triggers>

        </Style>

        <!-- TEXT INSIDE CELLS -->
        <Style x:Key="ProductTextStyle"
           TargetType="TextBlock">

            <Setter Property="Foreground" Value="#EDF2F7"/>
            <Setter Property="VerticalAlignment"
                Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming"
                Value="CharacterEllipsis"/>
        </Style>

    </Page.Resources>

    <!-- MAIN PAGE -->
    <Grid>

        <Grid.Background>
            <ImageBrush
            ImageSource="/Images/93fa0db3-59ca-4dc5-9ce6-204dfc3bee5e.jpeg"
            Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- DARK BACKGROUND OVERLAY -->
        <Border Background="#E8080D14"/>

        <Grid Margin="16,14,16,16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                Background="#E316202B"
                CornerRadius="12"
                BorderBrush="#455565"
                BorderThickness="1"
                Padding="15,12"
                Margin="0,0,0,12">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock
                        Text="PRODUCT MANAGEMENT"
                        Foreground="White"
                        FontSize="21"
                        FontFamily="Segoe UI"
                        FontWeight="Bold"/>

                        <TextBlock
                        Text="Mercedes-Benz Inventory"
                        Foreground="#A9B8C8"
                        FontSize="12"
                        Margin="0,5,0,0"/>

                    </StackPanel>

                    <!-- MERCEDES LOGO -->
                    <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                        <Image
                        Source="/Images/Mercedes Benz Brand Logo Symbol Black Design….jpeg"
                        Width="48"
                        Height="48"
                        Stretch="Uniform"
                        Margin="0,0,8,0"/>

                       

                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">

                        <TextBlock
                           Text="Mercedes"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="Bold"/>
 
                        <TextBlock
                          Text="BENZ"
                          Foreground="#A9B8C8"
                          FontSize="10"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- PRODUCT ACTIONS -->
            <Border Grid.Row="1"
                Background="#EA19232E"
                BorderBrush="#455565"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,12">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- PRODUCT COUNT -->
                    <StackPanel VerticalAlignment="Center">

                        <TextBlock
                        Text="INVENTORY OVERVIEW"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#A9BACB"
                        Margin="0,0,0,7"/>

                        <TextBlock
                        x:Name="TextBlockProductsCount"
                        Text="Available Product(s): 0"
                        Foreground="White"
                        FontSize="17"
                        FontWeight="Bold"/>

                    </StackPanel>

                    <!-- ADD PRODUCT -->
                    <Button
                    Grid.Column="1"
                    Name="ButtonNewProduct"
                    Content="+  Insert New Product"
                    Style="{StaticResource AddProductButtonStyle}"
                    Click="ButtonNewProduct_Click"
                    VerticalAlignment="Center"/>

                </Grid>

            </Border>

            <!-- PRODUCT TABLE CARD -->
            <Border Grid.Row="2"
                Background="#F0101822"
                BorderBrush="#455565"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TABLE TITLE -->
                    <Grid Grid.Row="0"
                      Background="#242F3D">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="16,13">

                            <TextBlock
                            Text="Vehicle Inventory"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="SemiBold"/>

                            <TextBlock
                            Text="Manage your available vehicles"
                            Foreground="#A8B8C8"
                            FontSize="11"
                            Margin="0,4,0,0"/>

                        </StackPanel>

                        <TextBlock
                        Grid.Column="1"
                        Text="Double-click a row to view details"
                        Foreground="#91A5B7"
                        FontSize="10"
                        VerticalAlignment="Center"
                        Margin="8,0,15,0"/>

                    </Grid>

                    <!-- PRODUCTS DATA GRID -->
                    <DataGrid
                    Grid.Row="1"
                    Name="DataGridProducts"
                    Style="{StaticResource ProductsGridStyle}"
                    RowStyle="{StaticResource ProductRowStyle}"
                    ColumnHeaderStyle="{StaticResource ProductHeaderStyle}"
                    CellStyle="{StaticResource ProductCellStyle}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    AlternationCount="2"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <!-- ID -->
                            <DataGridTextColumn
                            Header="ID"
                            Binding="{Binding Id}"
                            Width="60"
                            ElementStyle="{StaticResource ProductTextStyle}"/>

                            <!-- NAME -->
                            <DataGridTextColumn
                            Header="Name"
                            Binding="{Binding Name}"
                            Width="120"
                            ElementStyle="{StaticResource ProductTextStyle}"/>

                            <!-- DESCRIPTION -->
                            <DataGridTextColumn
                            Header="Description"
                            Binding="{Binding Description}"
                            Width="160"
                            ElementStyle="{StaticResource ProductTextStyle}"/>

                            <!-- PRICE -->
                            <DataGridTextColumn
                            Header="Price"
                            Binding="{Binding Price}"
                            Width="90"
                            ElementStyle="{StaticResource ProductTextStyle}"/>

                            <!-- QUANTITY -->
                            <DataGridTextColumn
                            Header="Quantity"
                            Binding="{Binding Quantity}"
                            Width="85"
                            ElementStyle="{StaticResource ProductTextStyle}"/>

                            <!-- COLOR -->
                            <DataGridTextColumn
                            Header="Color"
                            Binding="{Binding Color}"
                            Width="100"
                            ElementStyle="{StaticResource ProductTextStyle}"/>

                            <!-- HAND -->
                            <DataGridTextColumn
                            Header="Hand"
                            Binding="{Binding Hand}"
                            Width="70"
                            ElementStyle="{StaticResource ProductTextStyle}"/>

                            <!-- IMAGE -->
                            <DataGridTemplateColumn
                            Header="Image"
                            Width="110">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <Border
                                        Background="#263543"
                                        CornerRadius="7"
                                        Padding="3"
                                        HorizontalAlignment="Center">

                                            <Image
                                            Source="{Binding ImageStr, Converter={StaticResource Base64ImageConverter}}"
                                            Width="88"
                                            Height="53"
                                            Stretch="Uniform"
                                            HorizontalAlignment="Center"/>

                                        </Border>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- DELETE -->
                            <DataGridTemplateColumn
                            Header="Actions"
                            Width="105">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <Button
                                        x:Name="ButtonDelete"
                                        Content="Delete"
                                        Style="{StaticResource DeleteProductButtonStyle}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Click="ButtonDelete_Click"/>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>

<Window x:Class="AdminDesktop.EditUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdminDesktop"
        mc:Ignorable="d"
        Title="EditUser" Height="400" Width="450" WindowStartupLocation="CenterOwner">
    <Grid>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Edit User"
                  Click="EditUserMenu_Click"/>

                <Separator/>

                <MenuItem Header="Delete User"
                  Click="DeleteUserMenu_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
        
        <Grid.Background>
            <ImageBrush ImageSource="/Images/רקע יוקרתי_ סיבי פחמן ומתכת מוברשת.png"/>
        </Grid.Background>
        <StackPanel HorizontalAlignment="left" Width="400">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="10" HorizontalAlignment="Left" Text="FName" FontSize="20" Width="100" Foreground="White"/>
                <TextBox Name="TextBoxFName" Margin="10" FontSize="20" Width="270" HorizontalAlignment="Left" Text="{Binding Fname}" Background="{x:Null}" BorderBrush="White" Foreground="White" SelectionBrush="White"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="10" HorizontalAlignment="Left" Text="LName" FontSize="20" Width="100" Foreground="White"/>
                <TextBox Name="TextBoxLName" Margin="10" FontSize="20" Width="270" HorizontalAlignment="Left" Text="{Binding Lname}" SelectionBrush="White" BorderBrush="White" Foreground="White" Background="{x:Null}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="10" HorizontalAlignment="Left" Text="UserName" FontSize="20" Width="100" Foreground="White"/>
                <TextBox Name="TextBoxUserName" Margin="10" FontSize="20" Width="270" HorizontalAlignment="Left" Text="{Binding UserName}" SelectionBrush="White" Foreground="White" BorderBrush="White" Background="{x:Null}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="10" HorizontalAlignment="Left" Text="Password" FontSize="20" Width="100" Foreground="White"/>
                <TextBox Name="TextBoxPassword" Margin="10" FontSize="20" Width="270" HorizontalAlignment="Left" Text="{Binding Password}" SelectionBrush="White" Foreground="White" BorderBrush="White" Background="{x:Null}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="10" HorizontalAlignment="Left" Text="Email" FontSize="20" Width="100" Foreground="White"/>
                <TextBox Name="TextBoxEmailAddress" Margin="10" FontSize="20" Width="270" HorizontalAlignment="Left" Text="{Binding EmailAddress}" BorderBrush="White" Background="{x:Null}" Foreground="White" SelectionBrush="White"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="10" HorizontalAlignment="Left" Text="UserType" FontSize="20" Width="100" Foreground="White"/>
                <ComboBox Name="ComboBoxUserType" Margin="10" FontSize="20" Width="270" HorizontalAlignment="Left" Text="{Binding UserType}">
                    <ComboBoxItem x:Name="cbiAdmin" IsSelected="True">Admin</ComboBoxItem>
                    <ComboBoxItem x:Name="cbiClient" >Client</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <WrapPanel Margin="10" Grid.Row="3" Grid.ColumnSpan="5">
                <Button Width="80" Margin="5" FontSize="20" Name="ButtonPrev" 
                    Content="Prev" Click="ButtonPrev_Click" BorderBrush="White" Background="{x:Null}" Foreground="White" ></Button>
                <Button Width="80" Margin="5" FontSize="20" Name="ButtonNext" 
                    Content="Next" Click="ButtonNext_Click" Foreground="White" Background="{x:Null}" BorderBrush="White" ></Button>
                <Button Width="80" Margin="5" FontSize="20" Name="ButtonSave" 
                    Content="Save" Click="ButtonSave_Click" Background="{x:Null}" BorderBrush="White" Foreground="White" ></Button>
                <Button Width="80" Margin="5" FontSize="20" Name="ButtonCancel" 
                    Content="Cancel" Click="ButtonCancel_Click" Background="{x:Null}" BorderBrush="White" Foreground="White" ></Button>
            </WrapPanel>


        </StackPanel>

    </Grid>
</Window>

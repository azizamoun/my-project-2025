<UserControl x:Class="AdminDesktop.View.UserControls.MenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdminDesktop.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Menu x:Name="AdminMenu" Grid.Row="0">
            <MenuItem Name="MenuItem_Exit" Header="Exit" FontSize="16"   Click="MenuItem_Exit_Click" />
            <MenuItem Name="MenuItem_UsefulLinks"   Header="UsefulLinks Editor" FontSize="16"  Click="MenuItem_UsefulLinks_Click"/>
            <MenuItem Name="MenuItem_Users" Header="Users" FontSize="16" Click="MenuItem_Users_Click"/>
            <MenuItem Name="MenuItem_Products" Header="Products" FontSize="16" Click="MenuItem_Products_Click"/>
            <MenuItem Name="MenuItem_About" Header="About" FontSize="16" Click="MenuItem_About_Click"/>
            <MenuItem Name="MenuItem_Logout" Header="Logout" FontSize="16" Click="MenuItem_Logout_Click"/>
        </Menu>

        <Menu x:Name="ClientMenu" Grid.Row="0">
            <MenuItem Name="MenuItem_ExitC" Header="Exit" FontSize="16"   Click="MenuItem_ExitC_Click" />
            <MenuItem Name="MenuItem_ProductsC" Header="Products" FontSize="16" Click="MenuItem_ProductsC_Click"/>
            <MenuItem Name="MenuItem_LogoutC" Header="Logout" FontSize="16" Click="MenuItem_Logout_Click"/>
        </Menu>

        <Menu x:Name="GuestMenu" Grid.Row="0">
            <MenuItem Name="MenuItem_AboutV" Header="About" FontSize="16" Click="MenuItem_AboutV_Click"/>
            <MenuItem Name="MenuItem_SignIn" Header="SignIn" FontSize="16" Click="MenuItem_Login_Click"/>
        </Menu>


    </Grid>
</UserControl>

<Page x:Class="AdminDesktop.LogInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mercedes-Benz Login"
      Background="#090D12"
      FontFamily="Segoe UI">

    <Page.Resources>

        <LinearGradientBrush x:Key="PanelGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#26313C" Offset="0"/>
            <GradientStop Color="#111922" Offset="0.5"/>
            <GradientStop Color="#090D12" Offset="1"/>
        </LinearGradientBrush>

        <!-- TextBox -->
        <Style x:Key="InputText"
               TargetType="TextBox">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="CaretBrush"
                    Value="#D7B779"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="Padding"
                    Value="15,13"/>
        </Style>

        <!-- PasswordBox -->
        <Style x:Key="PasswordInput"
               TargetType="PasswordBox">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="Padding"
                    Value="15,13"/>
        </Style>

        <!-- Gold Button -->
        <Style x:Key="GoldButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#C9A96F"/>
            <Setter Property="Foreground"
                    Value="#10151A"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Height"
                    Value="52"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#E3C58C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Auto">

        <Grid MinWidth="850"
              MinHeight="600"
              Margin="25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelGradient}"
                    CornerRadius="24"
                    BorderBrush="#303D48"
                    BorderThickness="1"
                    Margin="0,0,15,0">

                <Grid>

                    <!-- Mercedes Logo -->
                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="40,35">

                        <Viewbox Width="48"
                                 Height="48">
                            <Grid Width="160"
                                  Height="160">

                                <Ellipse Stroke="#E9EDF1"
                                         StrokeThickness="5"
                                         Margin="5"/>

                                <Path
                                    Data="M80,80 L80,17 M80,80 L26,117 M80,80 L134,117"
                                    Stroke="#E9EDF1"
                                    StrokeThickness="7"/>

                            </Grid>
                        </Viewbox>

                        <TextBlock
                            Text="Mercedes-Benz"
                            Foreground="White"
                            FontFamily="Georgia"
                            FontSize="23"
                            VerticalAlignment="Center"
                            Margin="15,0,0,0"/>

                    </StackPanel>

                    <!-- Welcome Text -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Margin="40,50,40,0">

                        <TextBlock
                            Text="THE ART OF DRIVING"
                            Foreground="#C9A96F"
                            FontSize="12"
                            FontWeight="Bold"/>

                        <TextBlock
                            Text="Welcome to a&#10;world of luxury."
                            Foreground="White"
                            FontFamily="Georgia"
                            FontSize="40"
                            TextWrapping="Wrap"
                            Margin="0,20,0,20"/>

                        <Rectangle
                            Height="2"
                            Width="60"
                            Fill="#C9A96F"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,20"/>

                        <TextBlock
                            Text="Sign in to discover exclusive Mercedes-Benz vehicles and enjoy a premium driving experience."
                            Foreground="#B9C5D1"
                            FontSize="15"
                            TextWrapping="Wrap"
                            LineHeight="25"/>

                    </StackPanel>

                    <TextBlock
                        Text="LUXURY  •  INNOVATION  •  PERFORMANCE"
                        Foreground="#8897A7"
                        FontSize="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,35"/>

                </Grid>
            </Border>

            <!-- RIGHT SIDE -->
            <Border Grid.Column="1"
                    Background="#121820"
                    CornerRadius="24"
                    BorderBrush="#2B3540"
                    BorderThickness="1"
                    Margin="15,0,0,0"
                    Padding="35"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock
                        Text="MEMBER ACCESS"
                        Foreground="#C9A96F"
                        FontSize="12"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Welcome back"
                        Foreground="White"
                        FontSize="30"
                        FontWeight="Bold"
                        Margin="0,10,0,8"/>

                    <TextBlock
                        Text="Sign in to your Mercedes-Benz account."
                        Foreground="#AEB9C5"
                        FontSize="14"
                        Margin="0,0,0,30"/>

                    <!-- USERNAME -->
                    <TextBlock
                        Text="USERNAME"
                        Foreground="#D7DFE7"
                        FontSize="12"
                        FontWeight="Bold"
                        Margin="0,0,0,9"/>

                    <Border Background="#0D131B"
                            CornerRadius="10"
                            BorderBrush="#35404D"
                            BorderThickness="1">

                        <TextBox
                            x:Name="UsernameTextBox"
                            Style="{StaticResource InputText}"/>

                    </Border>

                    <!-- PASSWORD -->
                    <TextBlock
                        Text="PASSWORD"
                        Foreground="#D7DFE7"
                        FontSize="12"
                        FontWeight="Bold"
                        Margin="0,23,0,9"/>

                    <Border Background="#0D131B"
                            CornerRadius="10"
                            BorderBrush="#35404D"
                            BorderThickness="1">

                        <Grid>

                            <PasswordBox
                                x:Name="PasswordInputBox"
                                Style="{StaticResource PasswordInput}"/>

                            <TextBox
                                x:Name="VisiblePasswordTextBox"
                                Style="{StaticResource InputText}"
                                Visibility="Collapsed"/>

                        </Grid>
                    </Border>

                    <!-- SHOW PASSWORD -->
                    <CheckBox
                        x:Name="ShowPasswordCheckBox"
                        Content="Show Password"
                        Foreground="#BEC8D2"
                        FontSize="13"
                        HorizontalAlignment="Left"
                        Margin="0,19,0,28"
                        Checked="ShowPasswordCheckBox_Checked"
                        Unchecked="ShowPasswordCheckBox_Unchecked"/>

                    <!-- SIGN IN -->
                    <Button Content="SIGN IN"
        Style="{StaticResource GoldButton}"
        Click="SignIn_Click"/>

                    <!-- STATUS -->
                    <TextBlock
                        x:Name="StatusText"
                        Foreground="#E1B76E"
                        FontSize="13"
                        TextWrapping="Wrap"
                        Margin="0,15,0,0"/>

                    <!-- FOOTER -->
                    <TextBlock
                        Text="YOUR JOURNEY STARTS HERE"
                        Foreground="#83909D"
                        FontSize="11"
                        HorizontalAlignment="Center"
                        Margin="0,30,0,0"/>

                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>

</Page>

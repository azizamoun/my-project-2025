<Page x:Class="AdminDesktop.AllOrders"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="All Orders"
      Background="#090E15">

    <Page.Resources>

        <!-- ORDERS TABLE -->
        <Style x:Key="OrdersGridStyle"
               TargetType="DataGrid">

            <Setter Property="Background"
                    Value="#101923"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="RowBackground"
                    Value="#17212D"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#202D3B"/>

            <Setter Property="GridLinesVisibility"
                    Value="None"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="45"/>

            <Setter Property="RowHeight"
                    Value="45"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

        </Style>

        <!-- TABLE HEADERS -->
        <Style x:Key="HeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#293949"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderBrush"
                    Value="#455869"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,0"/>

        </Style>

        <!-- TABLE ROWS -->
        <Style x:Key="RowStyle"
               TargetType="DataGridRow">

            <Setter Property="Foreground"
                    Value="White"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#30475B"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#355B78"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- TABLE CELLS -->
        <Style x:Key="CellStyle"
               TargetType="DataGridCell">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="10,5"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="Transparent"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- CELL TEXT -->
        <Style x:Key="TextCellStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#F3F6FA"/>

            <Setter Property="TextAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>

    </Page.Resources>

    <!-- MAIN PAGE -->
    <Grid>

        <!-- BACKGROUND -->
        <Grid.Background>

            <LinearGradientBrush
                StartPoint="0,0"
                EndPoint="1,1">

                <GradientStop
                    Color="#080D14"
                    Offset="0"/>

                <GradientStop
                    Color="#1D2B3A"
                    Offset="0.5"/>

                <GradientStop
                    Color="#080D14"
                    Offset="1"/>

            </LinearGradientBrush>

        </Grid.Background>

        <Grid Margin="18">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#17222E"
                    CornerRadius="12"
                    BorderBrush="#435566"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,0,0,12">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock
                            Text="ALL ORDERS"
                            Foreground="White"
                            FontSize="23"
                            FontWeight="Bold"
                            FontFamily="Segoe UI"/>

                        <TextBlock
                            Text="Mercedes-Benz Order Management"
                            Foreground="#A9B9C9"
                            FontSize="12"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#293949"
                            CornerRadius="8"
                            Padding="13,8"
                            VerticalAlignment="Center">

                        <TextBlock
                            Text="MERCEDES-BENZ"
                            Foreground="#E4EAF0"
                            FontSize="11"
                            FontWeight="Bold"/>

                    </Border>

                </Grid>

            </Border>

            <!-- ORDERS COUNT -->
            <Border Grid.Row="1"
                    Background="#192632"
                    CornerRadius="12"
                    BorderBrush="#435566"
                    BorderThickness="1"
                    Padding="15"
                    Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock
                        Text="ORDERS OVERVIEW"
                        Foreground="#A3B6C8"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Margin="0,0,0,7"/>

                    <!-- REQUIRED BY C# -->
                    <TextBlock
                        x:Name="TextBlockOrdersCount"
                        Text="Available Orders(s): 0"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <!-- ORDERS TABLE -->
            <Border Grid.Row="2"
                    Background="#111A24"
                    CornerRadius="12"
                    BorderBrush="#435566"
                    BorderThickness="1"
                    ClipToBounds="True"
                    Margin="0,0,0,12">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <!-- TABLE TITLE -->
                    <Border Grid.Row="0"
                            Background="#263543"
                            Padding="15">

                        <StackPanel>

                            <TextBlock
                                Text="Orders Inventory"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="View and manage customer orders"
                                Foreground="#ADBDCC"
                                FontSize="11"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                    <!-- REQUIRED BY C# -->
                    <DataGrid
                        Grid.Row="1"
                        x:Name="listViewOrders"
                        Style="{StaticResource OrdersGridStyle}"
                        RowStyle="{StaticResource RowStyle}"
                        ColumnHeaderStyle="{StaticResource HeaderStyle}"
                        CellStyle="{StaticResource CellStyle}"
                        AutoGenerateColumns="False"
                        ColumnWidth="*"
                        AlternationCount="2"
                        SelectionChanged="listViewOrders_SelectionChanged"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <!-- ORDER ID -->
                            <DataGridTextColumn
                                Header="Order ID"
                                Binding="{Binding OrderId}"
                                Width="*"
                                MinWidth="85"
                                ElementStyle="{StaticResource TextCellStyle}"/>

                            <!-- USER ID -->
                            <DataGridTextColumn
                                Header="User ID"
                                Binding="{Binding UserId}"
                                Width="*"
                                MinWidth="85"
                                ElementStyle="{StaticResource TextCellStyle}"/>

                            <!-- STATUS -->
                            <DataGridTextColumn
                                Header="Status"
                                Binding="{Binding Status}"
                                Width="*"
                                MinWidth="90"
                                ElementStyle="{StaticResource TextCellStyle}"/>

                            <!-- DATE -->
                            <DataGridTextColumn
                                Header="Date"
                                Binding="{Binding Date}"
                                Width="1.3*"
                                MinWidth="115"
                                ElementStyle="{StaticResource TextCellStyle}"/>

                            <!-- TOTAL PRICE -->
                            <DataGridTextColumn
                                Header="Total Price"
                                Binding="{Binding TotalPrice}"
                                Width="*"
                                MinWidth="100"
                                ElementStyle="{StaticResource TextCellStyle}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!-- TOTAL SECTION -->
            <Border Grid.Row="3"
                    Background="#192632"
                    BorderBrush="#435566"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="17">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock
                            Text="TOTAL ORDER VALUE"
                            Foreground="#A9B9C9"
                            FontSize="11"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Summary of all orders"
                            Foreground="#8B9CAC"
                            FontSize="11"
                            Margin="0,6,0,0"/>

                    </StackPanel>

                    <!-- REQUIRED BY C# -->
                    <Border Grid.Column="1"
                            Background="#293C4D"
                            CornerRadius="8"
                            Padding="15,10"
                            VerticalAlignment="Center">

                        <Label
                            x:Name="totalLabel"
                            Content="Total = "
                            Foreground="White"
                            FontSize="19"
                            FontWeight="Bold"
                            Padding="0"
                            VerticalContentAlignment="Center"/>

                    </Border>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>

